@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860

    This page displays all of the movies in the collection
*@
@{
}

@model List<Movie>

<div class="container mt-4">
    <h1 class="mb-4">Joel Hilton's Movie Collection</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Year</th>
                    <th>Director</th>
                    <th>Rating</th>
                    <th>Edited</th>
                    <th>Lent To</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Title</td>
                        <td>@x.Category.CategoryName</td>
                        <td>@x.Year</td>
                        <td>@x.Director</td>
                        <td><span class="badge bg-secondary">@x.Rating</span></td>
                        <td>@(x.Edited ? "Yes" : "No")</td>
                        <td>@(string.IsNullOrEmpty(x.LentTo) ? "-" : x.LentTo)</td>
                        <td>
                            <a class="btn btn-sm btn-warning" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a class="btn btn-sm btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@{
}

@model Movie
<h2>Confirm Deletion</h2>
<h3>Are you sure you want to delete this movie?</h3>

<div>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Year:</strong> @Model.Year</p>
    <p><strong>Director:</strong> @Model.Director</p>
    <p><strong>Rating:</strong> @Model.Rating</p>
</div>

<form method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Collection">Cancel</a>
</form>